# ==============================================================================
# AMORA - Environment Configuration Template
# Copy this file to .env and provide your deployment-specific values.
# DO NOT commit .env or any file containing private keys/secrets to version control.
# ==============================================================================

# Server Network Configuration
PORT=4016
NODE_ENV=production
# Comma-separated list of allowed origins for CORS (e.g., https://your-domain.com)
CORS_ORIGIN=http://localhost:4016,http://localhost:4000

# Database Configuration (Relative to project root or absolute path)
DATABASE_PATH=backend/data/amora.sqlite

# Authentication & Legacy Fallback
# Set to 'false' in production. Firebase Authentication is the primary provider.
ALLOW_LEGACY_AUTH=false
# Secret used only if legacy JWT local authentication is explicitly enabled
JWT_SECRET=replace-with-a-random-64-char-secret-in-production

# Firebase Admin SDK Configuration (Server-Side)
# Option 1: File path to service account key (recommended for VM/container mounts)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-adminsdk.json
# Option 2: Inline JSON string of service account key (alternative for serverless/PaaS)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase Client SDK Configuration (Served to browser via /api/firebase-config)
# These public keys identify the Firebase project in the client app.
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=amora-6134f.firebaseapp.com
FIREBASE_PROJECT_ID=amora-6134f
FIREBASE_STORAGE_BUCKET=amora-6134f.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=your-web-app-id
